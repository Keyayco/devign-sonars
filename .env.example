# Server & Runtime
NODE_ENV=development
PORT=3000
BASE_PATH=
DB_PATH=./data/lead_monitor.db

# Operator Access Control (Required in production; optional in local development)
SONARS_ACCESS_KEY=

# Telegram Alerting (Optional — set in Render / hosting secrets; never commit real values)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Development / Local Testing Flag (Set to 1 only to allow http://localhost test feeds)
SONARS_ALLOW_HTTP_FEEDS=0
