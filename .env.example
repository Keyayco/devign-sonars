# Server & Runtime
NODE_ENV=development
PORT=3000
BASE_PATH=
DB_PATH=./data/lead_monitor.db

# Operator Access Control (Required in production; optional in local development)
SONARS_ACCESS_KEY=

# Telegram Alerting (Optional — set in Render / hosting secrets; never commit real values)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CIPC APIVerse Companies API (Optional — disabled by default; obtain from https://developer.cipc.co.za/)
CIPC_ENABLED=false
CIPC_CLIENT_ID=
CIPC_CLIENT_SECRET=
CIPC_TOKEN_URL=
CIPC_API_BASE_URL=
CIPC_SEARCH_PATH=
CIPC_COMPANY_PATH=
CIPC_SCOPE=
CIPC_INCLUDE_DIRECTORS=0

# OpenStreetMap / Overpass Discovery (Optional — defaults to public Overpass for controlled on-demand runs)
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# POPIA Retention Policy (Optional — days to retain unapproved discovery records before purge)
SONARS_RETENTION_DAYS=180
